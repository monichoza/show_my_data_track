<?xml version="1.0" encoding="UTF-8"?>
<settings version="2">
    <section id="general" label="General">
        <category id="trakt_credentials" label="Trakt API Credentials">
            <setting id="trakt_client_id" type="text" label="Client ID" default="" subsetting="true"/>
            <setting id="trakt_client_secret" type="text" label="Client Secret" default="" option="hidden"/>
        </category>
        <category id="auth_status" label="Authentication">
            <setting id="auth_button" type="action" label="Authorize with Trakt" action="RunScript(plugin.trakt.watchlist,action,auth)"/>
            <setting id="trakt_username" type="text" label="Username (optional)" default="" subsetting="true"/>
        </category>
    </section>
    <section id="display" label="Display Options">
        <category id="list_options" label="List Options">
            <setting id="sort_order" type="select" label="Sort Order" values="Title|Year|Recently Watched" default="Recently Watched"/>
            <setting id="show_counts" type="bool" label="Show play counts" default="true"/>
        </category>
    </section>
</settings>